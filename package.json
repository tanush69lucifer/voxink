{
  "name": "voxink",
  "version": "0.2.0",
  "description": "VoxInk — say it, and the screen performs it. A live motion-graphics director for talks and pitches.",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.6"
  },
  "dependencies": {
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/bungee-outline": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/creepster": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/pacifico": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/rubik-burned": "^5.3.0",
    "@fontsource/rubik-glitch": "^5.3.0",
    "@fontsource/rubik-wet-paint": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@iconify-json/ph": "^1.2.2",
    "@types/topojson-client": "^3.1.5",
    "hono": "^4.13.22",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "ws": "^8.23.0"
  },
  "private": true,
  "type": "module"
}
